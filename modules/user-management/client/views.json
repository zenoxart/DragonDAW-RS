{
  "moduleId": "user-management",
  "version": "1.0.0",
  "icons": { "home": "👥", "organization": "🏢", "add": "➕", "edit": "✏", "roles": "🛡", "reset": "🔑" },
  "groups": [
    { "menu": "shell.mainmenu", "path": "users", "label": "users:menu", "icon": "users.home", "order": 40 },
    { "menu": "shell.navigation", "path": "users", "label": "users:module.name", "icon": "users.home", "order": 40 }
  ],
  "views": [
    {
      "key": "users.directory", "title": "users:view.directory", "icon": "users.home", "home": true, "permission": "users.view",
      "liveEvents": ["users.*"], "order": 0,
      "body": {
        "kind": "list", "endpoint": "/api/users", "items": "", "search": true,
        "filters": [{ "param": "status", "label": "users:field.status", "options": [
          { "value": "all", "label": "users:status.all" }, { "value": "active", "label": "users:status.active" }, { "value": "inactive", "label": "users:status.inactive" } ] }],
        "groupBy": "department",
        "columns": [
          { "field": "displayName", "label": "users:field.displayName", "width": 2 },
          { "field": "userName", "label": "users:field.userName" },
          { "field": "jobTitle", "label": "users:field.jobTitle", "width": 2 },
          { "field": "roles", "label": "users:field.roles", "format": "list" },
          { "field": "isActive", "label": "users:field.active", "format": "bool", "width": 0.6 }
        ],
        "detail": [
          { "field": "displayName", "label": "users:field.displayName" },
          { "field": "email", "label": "users:field.email" },
          { "field": "department", "label": "users:field.department" },
          { "field": "costCenter", "label": "users:field.costCenter" },
          { "field": "jobTitle", "label": "users:field.jobTitle" },
          { "field": "phone", "label": "users:field.phone" },
          { "field": "location", "label": "users:field.location" },
          { "field": "manager", "label": "users:field.manager" },
          { "field": "approvalLimit", "label": "users:field.approvalLimit", "format": "money" },
          { "field": "hiredOn", "label": "users:field.hiredOn", "format": "date" },
          { "field": "lastLoginAt", "label": "users:field.lastLogin", "format": "dateTime" }
        ],
        "toolbarActions": [
          { "id": "create", "label": "users:action.create", "icon": "users.add", "permission": "users.edit", "method": "POST", "endpoint": "/api/users",
            "command": "users.create", "showResult": true, "success": "users:success.created",
            "form": { "schemaId": "users.onboarding", "fields": [
              { "name": "displayName", "type": "text", "label": "users:field.displayName", "required": true, "maxLength": 100 },
              { "name": "userName", "type": "text", "label": "users:field.userName", "required": true, "pattern": "^[a-z][a-z0-9.\\-]{2,40}$", "span": "half" },
              { "name": "email", "type": "text", "label": "users:field.email", "required": true, "span": "half" },
              { "name": "departmentId", "type": "entityRef", "label": "users:field.department", "lookup": "/api/users/lookups/departments", "span": "half" },
              { "name": "jobTitle", "type": "text", "label": "users:field.jobTitle", "span": "half" },
              { "name": "role", "type": "entityRef", "label": "users:field.role", "required": true, "default": "Viewer", "lookup": "/api/users/lookups/roles" }
            ] } }
        ],
        "rowActions": [
          { "id": "edit", "label": "users:action.edit", "icon": "users.edit", "permission": "users.edit", "method": "PUT", "endpoint": "/api/users/{id}",
            "command": "users.edit", "success": "users:success.saved", "body": { "rowVersion": "row.rowVersion" },
            "prefill": { "displayName": "row.displayName", "email": "row.email", "departmentId": "row.departmentId", "jobTitle": "row.jobTitle",
                         "phone": "row.phone", "location": "row.location", "isActive": "row.isActive" },
            "form": { "schemaId": "users.edit", "fields": [
              { "name": "displayName", "type": "text", "label": "users:field.displayName", "required": true },
              { "name": "email", "type": "text", "label": "users:field.email", "required": true, "span": "half" },
              { "name": "departmentId", "type": "entityRef", "label": "users:field.department", "lookup": "/api/users/lookups/departments", "span": "half" },
              { "name": "jobTitle", "type": "text", "label": "users:field.jobTitle", "span": "half" },
              { "name": "phone", "type": "text", "label": "users:field.phone", "span": "half" },
              { "name": "location", "type": "text", "label": "users:field.location", "span": "half" },
              { "name": "isActive", "type": "boolean", "label": "users:field.active", "span": "half" }
            ] } },
          { "id": "roles", "label": "users:action.roles", "icon": "users.roles", "permission": "users.roles", "method": "PUT", "endpoint": "/api/users/{id}/roles",
            "success": "users:success.saved", "prefill": { "roles": "join(row.roles, ', ')" }, "body": { "roles": "split(form.roles, ',')" },
            "form": { "schemaId": "users.roles", "fields": [{ "name": "roles", "type": "text", "label": "users:field.rolesInput", "required": true }] } },
          { "id": "reset", "label": "users:action.resetPassword", "icon": "users.reset", "permission": "users.edit", "method": "POST",
            "endpoint": "/api/users/{id}/reset-password", "confirm": "users:confirm.reset", "showResult": true }
        ]
      }
    },
    {
      "key": "users.organization", "title": "users:view.organization", "icon": "users.organization", "permission": "users.view", "liveEvents": ["users.*"], "order": 1,
      "body": {
        "kind": "list", "endpoint": "/api/users/organization", "items": "",
        "columns": [
          { "field": "name", "label": "users:field.department", "width": 2 },
          { "field": "costCenter", "label": "users:field.costCenter" },
          { "field": "members", "label": "users:field.members", "format": "number", "width": 0.6 },
          { "field": "people", "label": "users:field.people", "format": "list", "width": 4 }
        ]
      }
    }
  ],
  "commands": [],
