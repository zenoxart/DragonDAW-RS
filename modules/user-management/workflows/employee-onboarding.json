{
  "id": "50000000-0000-0000-0000-000000000004",
  "version": 1,
  "name": "Onboard a new employee",
  "description": "Collect the new employee's data, let an administrator confirm, then create the account.",
  "origin": "moduleTemplate",
  "owningModule": "user-management",
  "ownerId": "10000000-0000-0000-0000-000000000001",
  "status": "active",
  "startStepId": "data",
  "steps": [
    { "id": "data", "kind": "input", "title": "Employee data",
      "input": {
        "schemaId": "users.onboarding", "version": 1,
        "fields": [
          { "name": "displayName", "type": "text", "label": "users:field.displayName", "required": true, "maxLength": 100 },
          { "name": "userName", "type": "text", "label": "users:field.userName", "required": true, "pattern": "^[a-z][a-z0-9.\\-]{2,40}$", "span": "half" },
          { "name": "email", "type": "text", "label": "users:field.email", "required": true, "span": "half" },
          { "name": "departmentId", "type": "entityRef", "label": "users:field.department", "required": true, "lookup": "/api/users/lookups/departments", "span": "half" },
          { "name": "jobTitle", "type": "text", "label": "users:field.jobTitle", "span": "half" },
          { "name": "role", "type": "choice", "label": "users:field.role", "required": true, "default": "Viewer",
            "options": [ { "value": "Viewer", "label": "Viewer" }, { "value": "Clerk", "label": "Clerk" }, { "value": "Analyst", "label": "Analyst" }, { "value": "Approver", "label": "Approver" } ] }
        ]
      } },
    { "id": "confirm", "kind": "approval", "title": "Confirm the new account", "approvers": ["users.edit"] },
    { "id": "create", "kind": "moduleStep", "title": "Create the account", "stepTypeId": "users.createUser",
      "parameters": { "displayName": "vars.displayName", "userName": "vars.userName", "email": "vars.email", "departmentId": "vars.departmentId", "jobTitle": "vars.jobTitle", "role": "vars.role" } }
  ],
  "transitions": [
    { "from": "data", "to": "confirm" },
    { "from": "confirm", "to": "create", "condition": "last.decision == 'approve'", "order": 1 },
    { "from": "confirm", "to": "end", "order": 2 },
    { "from": "create", "to": "end" }
  ],
  "triggers": [{ "id": "manual", "kind": "manual" }],
  "aiPolicy": { "autonomy": "off" }
}
