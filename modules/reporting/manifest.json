{
  "moduleId": "reporting",
  "version": "1.0.0",
  "displayName": "reports:module.name",
  "description": "Report catalogue, parameters and charts.",
  "icon": "reports.home",
  "accentColor": "#AD1457",
  "minHostVersion": "1.0.0",
  "contractsVersion": 1,
  "prefix": "reports",
  "client": { "package": "reporting-1.0.0.zip", "viewPack": "views.json", "hotSwap": "supported" },
  "backend": { "service": "http://reporting-service:8080", "apiVersion": "v1", "route": "/api/reports" },
  "permissions": ["reports.view", "reports.run"],
  "dependencies": [{ "moduleId": "user-management", "versionRange": ">=1.0.0 <3.0.0" }],
  "languages": ["en", "de"],
  "defaultLanguage": "en",
  "contractSurface": {
    "backendApiVersion": "v1",
    "commands": [
      { "id": "reports.run", "workflowCapable": true, "aiAllowed": true, "endpoint": "/api/reports/workflow-steps/reports.runReport" }
    ],
    "inputSchemas": [],
    "stepTypes": [
      {
        "id": "reports.runReport", "version": 1, "title": "reports:step.runReport", "headless": true,
        "endpoint": "/api/reports/workflow-steps/reports.runReport",
        "input": { "schemaId": "reports.runReport", "fields": [
          { "name": "reportId", "type": "text", "label": "reports:field.report", "required": true },
          { "name": "parameters", "type": "multiLine", "label": "reports:field.parameters" }
        ] },
        "outputs": ["runId", "rowCount", "total"]
      }
    ],
    "events": [{ "type": "reports.ready", "payloadVersion": 1, "fields": ["runId", "reportId", "rowCount", "total"] }],
    "templates": ["daily-sales-briefing"],
    "migrations": []
  }
}
