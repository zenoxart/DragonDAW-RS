{
  "id": "50000000-0000-0000-0000-000000000002",
  "version": 1,
  "name": "Send approved invoices to accounting",
  "description": "Every approved invoice document is sent to the accounting mailbox.",
  "origin": "moduleTemplate",
  "owningModule": "document-management",
  "ownerId": "10000000-0000-0000-0000-000000000001",
  "status": "active",
  "startStepId": "send",
  "steps": [
    { "id": "send", "kind": "command", "title": "Send to accounting", "commandId": "documents.send",
      "parameters": { "documentId": "vars.documentId", "recipient": "'accounting@redhive.demo'" } }
  ],
  "transitions": [{ "from": "send", "to": "end" }],
  "triggers": [
    { "id": "approved", "kind": "event", "eventType": "documents.invoice.approved", "filter": "!isEmpty(payload.documentId)",
      "payloadMapping": { "documentId": "payload.documentId", "number": "payload.number" }, "deduplicationKey": "payload.invoiceId",
      "executor": "human", "runAs": "10000000-0000-0000-0000-000000000001" }
  ],
  "aiPolicy": { "autonomy": "off" }
}
