{
  "moduleId": "document-management",
  "version": "1.0.0",
  "icons": { "home": "📂", "invoice": "📄", "library": "📁", "approve": "✅", "reject": "⛔", "submit": "📨", "pay": "💶", "add": "➕", "edit": "✏", "archive": "📦", "version": "⤴" },
  "groups": [
    { "menu": "shell.mainmenu", "path": "documents", "label": "documents:menu", "icon": "documents.home", "order": 20 },
    { "menu": "shell.navigation", "path": "documents", "label": "documents:module.name", "icon": "documents.home", "order": 20 }
  ],
  "views": [
    {
      "key": "documents.home", "title": "documents:view.home", "icon": "documents.home", "home": true, "permission": "documents.view",
      "liveEvents": ["documents.*"], "order": 0,
      "body": {
        "kind": "dashboard", "endpoint": "/api/documents/stats",
        "cards": [
          { "label": "documents:card.submitted", "value": "invoices.submitted", "format": "number", "icon": "documents.submit", "navigate": "documents.invoices" },
          { "label": "documents:card.openAmount", "value": "invoices.openAmount", "format": "money", "icon": "documents.pay" },
          { "label": "documents:card.overdue", "value": "invoices.overdue", "format": "number", "icon": "documents.invoice", "navigate": "documents.invoices" },
          { "label": "documents:card.activeDocuments", "value": "documents.active", "format": "number", "icon": "documents.library", "navigate": "documents.library" }
        ],
        "chart": { "title": "documents:chart.byCostCenter", "items": "byCostCenter", "labelField": "label", "valueField": "value", "kind": "bar", "format": "money" },
        "lists": [
          { "title": "documents:list.awaitingApproval", "items": "awaitingApproval", "navigate": "documents.invoices",
            "columns": [
              { "field": "number", "label": "documents:field.number" },
              { "field": "supplier", "label": "documents:field.supplier", "width": 2 },
              { "field": "amount", "label": "documents:field.amount", "format": "money", "currencyField": "currency" },
              { "field": "submittedByName", "label": "documents:field.submittedBy" }
            ] }
        ]
      }
    },
    {
      "key": "documents.invoices", "title": "documents:view.invoices", "icon": "documents.invoice", "permission": "documents.view",
      "liveEvents": ["documents.invoice.*"], "order": 1,
      "body": {
        "kind": "list", "endpoint": "/api/documents/invoices", "items": "items", "search": true,
        "filters": [{ "param": "status", "label": "documents:field.status", "options": [
          { "value": "all", "label": "documents:status.all" }, { "value": "draft", "label": "documents:status.draft" },
          { "value": "submitted", "label": "documents:status.submitted" }, { "value": "approved", "label": "documents:status.approved" },
          { "value": "rejected", "label": "documents:status.rejected" }, { "value": "paid", "label": "documents:status.paid" }
        ] }],
        "columns": [
          { "field": "number", "label": "documents:field.number" },
          { "field": "supplier", "label": "documents:field.supplier", "width": 2 },
          { "field": "amount", "label": "documents:field.amount", "format": "money", "currencyField": "currency" },
          { "field": "dueOn", "label": "documents:field.dueOn", "format": "date" },
          { "field": "costCenter", "label": "documents:field.costCenter" },
          { "field": "status", "label": "documents:field.status", "format": "badge" }
        ],
        "detail": [
          { "field": "number", "label": "documents:field.number" },
          { "field": "supplier", "label": "documents:field.supplier" },
          { "field": "amount", "label": "documents:field.amount", "format": "money", "currencyField": "currency" },
          { "field": "issuedOn", "label": "documents:field.issuedOn", "format": "date" },
          { "field": "dueOn", "label": "documents:field.dueOn", "format": "date" },
          { "field": "costCenter", "label": "documents:field.costCenter" },
          { "field": "status", "label": "documents:field.status", "format": "badge" },
          { "field": "submittedByName", "label": "documents:field.submittedBy" },
          { "field": "submittedAt", "label": "documents:field.submittedAt", "format": "dateTime" },
          { "field": "decidedByName", "label": "documents:field.decidedBy" },
          { "field": "decidedAt", "label": "documents:field.decidedAt", "format": "dateTime" },
          { "field": "comment", "label": "documents:field.comment" }
        ],
        "toolbarActions": [
          { "id": "create", "label": "documents:action.createInvoice", "icon": "documents.add", "permission": "documents.edit", "method": "POST",
            "endpoint": "/api/documents/invoices", "command": "documents.invoice.create", "success": "documents:success.created",
            "form": { "schemaId": "documents.invoice", "fields": [
              { "name": "supplier", "type": "text", "label": "documents:field.supplier", "required": true, "maxLength": 200 },
              { "name": "amount", "type": "money", "label": "documents:field.amount", "required": true, "min": 0, "span": "half" },
              { "name": "currency", "type": "choice", "label": "documents:field.currency", "default": "EUR", "span": "half",
                "options": [{ "value": "EUR", "label": "EUR" }, { "value": "CHF", "label": "CHF" }, { "value": "USD", "label": "USD" }] },
              { "name": "issuedOn", "type": "date", "label": "documents:field.issuedOn", "required": true, "span": "half" },
              { "name": "dueOn", "type": "date", "label": "documents:field.dueOn", "required": true, "span": "half" },
              { "name": "costCenter", "type": "entityRef", "label": "documents:field.costCenter", "required": true, "lookup": "/api/documents/lookups/cost-centers" },
              { "name": "comment", "type": "multiLine", "label": "documents:field.comment", "maxLength": 500 }
            ] } }
        ],
        "rowActions": [
          { "id": "edit", "label": "documents:action.edit", "icon": "documents.edit", "permission": "documents.edit", "method": "PUT",
            "endpoint": "/api/documents/invoices/{id}", "visibleWhen": "row.status == 'draft' || row.status == 'rejected'",
            "prefill": { "supplier": "row.supplier", "amount": "row.amount", "currency": "row.currency", "issuedOn": "row.issuedOn", "dueOn": "row.dueOn", "costCenter": "row.costCenter", "comment": "row.comment" },
            "body": { "rowVersion": "row.rowVersion" },
            "form": { "schemaId": "documents.invoice", "fields": [
              { "name": "supplier", "type": "text", "label": "documents:field.supplier", "required": true, "maxLength": 200 },
              { "name": "amount", "type": "money", "label": "documents:field.amount", "required": true, "min": 0, "span": "half" },
              { "name": "currency", "type": "choice", "label": "documents:field.currency", "span": "half",
                "options": [{ "value": "EUR", "label": "EUR" }, { "value": "CHF", "label": "CHF" }, { "value": "USD", "label": "USD" }] },
              { "name": "issuedOn", "type": "date", "label": "documents:field.issuedOn", "required": true, "span": "half" },
              { "name": "dueOn", "type": "date", "label": "documents:field.dueOn", "required": true, "span": "half" },
              { "name": "costCenter", "type": "entityRef", "label": "documents:field.costCenter", "required": true, "lookup": "/api/documents/lookups/cost-centers" },
              { "name": "comment", "type": "multiLine", "label": "documents:field.comment", "maxLength": 500 }
            ] }, "success": "documents:success.saved" },
          { "id": "submit", "label": "documents:action.submit", "icon": "documents.submit", "permission": "documents.edit", "method": "POST",
            "endpoint": "/api/documents/invoices/{id}/submit", "visibleWhen": "row.status == 'draft' || row.status == 'rejected'",
            "confirm": "documents:confirm.submit", "command": "documents.invoice.submit", "success": "documents:success.submitted" },
          { "id": "approve", "label": "documents:action.approve", "icon": "documents.approve", "permission": "documents.approve", "method": "POST",
            "endpoint": "/api/documents/invoices/{id}/approve", "visibleWhen": "row.status == 'submitted' && row.submittedBy != user.id",
            "command": "documents.invoice.approve", "body": { "rowVersion": "row.rowVersion" },
            "form": { "schemaId": "documents.decision", "fields": [{ "name": "comment", "type": "multiLine", "label": "documents:field.comment", "maxLength": 500 }] },
            "success": "documents:success.approved" },
          { "id": "reject", "label": "documents:action.reject", "icon": "documents.reject", "permission": "documents.approve", "method": "POST",
            "endpoint": "/api/documents/invoices/{id}/reject", "visibleWhen": "row.status == 'submitted' && row.submittedBy != user.id",
            "body": { "rowVersion": "row.rowVersion" },
            "form": { "schemaId": "documents.rejection", "fields": [{ "name": "comment", "type": "multiLine", "label": "documents:field.reason", "required": true, "maxLength": 500 }] },
            "success": "documents:success.rejected" },
          { "id": "pay", "label": "documents:action.pay", "icon": "documents.pay", "permission": "documents.approve", "method": "POST",
            "endpoint": "/api/documents/invoices/{id}/pay", "visibleWhen": "row.status == 'approved'", "confirm": "documents:confirm.pay", "success": "documents:success.paid" }
        ]
      }
    },
    {
      "key": "documents.library", "title": "documents:view.library", "icon": "documents.library", "permission": "documents.view",
      "liveEvents": ["documents.created", "documents.updated"], "order": 2,
      "body": {
        "kind": "list", "endpoint": "/api/documents", "items": "items", "search": true,
        "filters": [
          { "param": "category", "label": "documents:field.category", "options": [
            { "value": "all", "label": "documents:status.all" }, { "value": "contract", "label": "documents:category.contract" },
            { "value": "report", "label": "documents:category.report" }, { "value": "invoice", "label": "documents:category.invoice" },
            { "value": "other", "label": "documents:category.other" } ] },
          { "param": "status", "label": "documents:field.status", "options": [
            { "value": "all", "label": "documents:status.all" }, { "value": "draft", "label": "documents:status.draft" },
            { "value": "active", "label": "documents:status.active" }, { "value": "archived", "label": "documents:status.archived" } ] }
        ],
        "columns": [
          { "field": "title", "label": "documents:field.title", "width": 3 },
          { "field": "category", "label": "documents:field.category", "format": "badge" },
          { "field": "status", "label": "documents:field.status", "format": "badge" },
          { "field": "ownerName", "label": "documents:field.owner" },
          { "field": "currentVersion", "label": "documents:field.version", "format": "number", "width": 0.6 },
          { "field": "updatedAt", "label": "documents:field.updatedAt", "format": "dateTime" }
        ],
        "detail": [
          { "field": "title", "label": "documents:field.title" },
          { "field": "fileName", "label": "documents:field.fileName" },
          { "field": "sizeBytes", "label": "documents:field.size", "format": "bytes" },
          { "field": "tags", "label": "documents:field.tags", "format": "list" },
          { "field": "createdAt", "label": "documents:field.createdAt", "format": "dateTime" }
        ],
        "toolbarActions": [
          { "id": "create", "label": "documents:action.createDocument", "icon": "documents.add", "permission": "documents.edit", "method": "POST",
            "endpoint": "/api/documents", "command": "documents.create", "success": "documents:success.created",
            "body": { "tags": "split(form.tags, ',')" },
            "form": { "schemaId": "documents.document", "fields": [
              { "name": "title", "type": "text", "label": "documents:field.title", "required": true, "maxLength": 200 },
              { "name": "category", "type": "choice", "label": "documents:field.category", "required": true, "default": "contract", "span": "half",
                "options": [{ "value": "contract", "label": "documents:category.contract" }, { "value": "report", "label": "documents:category.report" }, { "value": "other", "label": "documents:category.other" }] },
              { "name": "fileName", "type": "text", "label": "documents:field.fileName", "required": true, "span": "half" },
              { "name": "sizeBytes", "type": "number", "label": "documents:field.size", "min": 0, "default": 0, "span": "half" },
              { "name": "tags", "type": "text", "label": "documents:field.tags", "span": "half" }
            ] } }
        ],
        "rowActions": [
          { "id": "version", "label": "documents:action.newVersion", "icon": "documents.version", "permission": "documents.edit", "method": "POST",
            "endpoint": "/api/documents/{id}/versions", "visibleWhen": "row.status != 'archived'", "body": { "rowVersion": "row.rowVersion" },
            "form": { "schemaId": "documents.version", "fields": [
              { "name": "fileName", "type": "text", "label": "documents:field.fileName", "required": true },
              { "name": "sizeBytes", "type": "number", "label": "documents:field.size", "min": 0, "default": 0 },
              { "name": "comment", "type": "text", "label": "documents:field.comment" }
            ] }, "success": "documents:success.saved" },
          { "id": "archive", "label": "documents:action.archive", "icon": "documents.archive", "permission": "documents.edit", "method": "POST",
            "endpoint": "/api/documents/{id}/archive", "visibleWhen": "row.status != 'archived'", "confirm": "documents:confirm.archive", "success": "documents:success.saved" },
          { "id": "activate", "label": "documents:action.activate", "icon": "documents.version", "permission": "documents.edit", "method": "POST",
            "endpoint": "/api/documents/{id}/activate", "visibleWhen": "row.status != 'active'", "success": "documents:success.saved" }
        ]
      }
    }
  ],
  "commands": [
    {
      "descriptor": { "id": "documents.invoice.new", "label": "documents:action.createInvoice", "icon": "documents.add", "permission": "documents.edit",
        "placements": [{ "menu": "shell.mainmenu", "path": "documents", "section": 1, "order": 0 }, { "menu": "shell.toolbar", "path": "", "section": 5, "order": 0 }],
        "shortcuts": [{ "gesture": "Ctrl+Shift+N", "scope": "global" }], "workflowCapable": true, "moduleId": "document-management" },
      "run": { "kind": "navigate", "view": "documents.invoices" }
    }
  ],
