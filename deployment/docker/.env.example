# Copy to .env and change every secret before running anywhere but your own machine.
REDHIVE_VERSION=latest
REDHIVE_PORT=8080
POSTGRES_USER=redhive
POSTGRES_PASSWORD=change-me
POSTGRES_DB=redhive
# HS256 key for user tokens (at least 32 random characters)
REDHIVE_JWT_KEY=change-me-to-a-long-random-secret-0123456789
# Shared secret for service-to-service calls (x-redhive-internal-key)
REDHIVE_INTERNAL_KEY=change-me-internal-secret
# Optional: PKCS#8 PEM of the package signing key (newlines as \n). Empty = generated and stored in the database.
REDHIVE_SIGNING_KEY=
# AI agent: "rules" (built-in, offline) or "openai" (any OpenAI-compatible endpoint)
REDHIVE_AI_PROVIDER=rules
REDHIVE_AI_ENDPOINT=
REDHIVE_AI_API_KEY=
REDHIVE_AI_MODEL=
REDHIVE_AI_REVIEW_LIMIT=20000
# Optional Windows push notifications (WNS)
REDHIVE_WNS_PACKAGE_SID=
REDHIVE_WNS_CLIENT_SECRET=
REDHIVE_RATE_LIMIT_PER_MINUTE=600
RUST_LOG=info
